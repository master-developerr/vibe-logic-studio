# =========================================================================
# Vibe Logic Studio — Environment Variables Template
# =========================================================================
#
# Copy this file to `.env.local` and fill in the values for local development.
# DO NOT commit the filled `.env.local` file to the repository.
#
# =========================================================================

# -------------------------------------------------------------------------
# Convex configuration
# -------------------------------------------------------------------------
# Deployment target used by `npx convex dev`
CONVEX_DEPLOYMENT=your_convex_deployment_selector_here # e.g., dev:joyous-egret-150

# Public URL of the Convex database instance (consumed by Client & Webhooks)
NEXT_PUBLIC_CONVEX_URL=your_convex_deployment_url_here

# Public site URL of Convex HTTP endpoints
NEXT_PUBLIC_CONVEX_SITE_URL=your_convex_site_url_here

# -------------------------------------------------------------------------
# Upstash Redis (Distributed caching & Rate Limiting)
# -------------------------------------------------------------------------
# Server-side connection URL
UPSTASH_REDIS_REST_URL=your_upstash_redis_rest_url_here

# Server-side access token (Keep secret!)
UPSTASH_REDIS_REST_TOKEN=your_upstash_redis_rest_token_here

# -------------------------------------------------------------------------
# Clerk Authentication
# -------------------------------------------------------------------------
# Publicly accessible publishable key for Clerk client
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=your_clerk_publishable_key_here

# Server-side API key (Keep secret!)
CLERK_SECRET_KEY=your_clerk_secret_key_here

# Sign-in / Sign-up routes configuration
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/

# -------------------------------------------------------------------------
# UploadThing (Media storage and uploads)
# -------------------------------------------------------------------------
# Server-side secret key (Keep secret!)
UPLOADTHING_SECRET=your_uploadthing_secret_here

# Project app ID
UPLOADTHING_APP_ID=your_uploadthing_app_id_here

# -------------------------------------------------------------------------
# PostHog Analytics
# -------------------------------------------------------------------------
# Public key for tracking initialization
NEXT_PUBLIC_POSTHOG_KEY=your_posthog_key_here

# Analytics ingestion host endpoint
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# -------------------------------------------------------------------------
# Razorpay Payment Integration
# -------------------------------------------------------------------------
# Public API key ID (rendered by Checkout modal)
NEXT_PUBLIC_RAZORPAY_KEY_ID=your_razorpay_key_id_here

# Server-side API key secret (Keep secret!)
RAZORPAY_KEY_SECRET=your_razorpay_key_secret_here

# Secret used to verify incoming Razorpay webhook signatures (Keep secret!)
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret_here

# -------------------------------------------------------------------------
# Sentry (Error monitoring and tracing)
# -------------------------------------------------------------------------
# Auth token used by the Sentry build plugin to upload source maps
SENTRY_AUTH_TOKEN=your_sentry_auth_token_here
