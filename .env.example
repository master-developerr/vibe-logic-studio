# =========================================================================
# Vibe Logic Studio — Environment Variables Template
# =========================================================================
#
# Copy this file to `.env.local` and fill in the values for local development.
# DO NOT commit the filled `.env.local` file to the repository.
#
# =========================================================================

# -------------------------------------------------------------------------
# Convex configuration
# -------------------------------------------------------------------------
# Deployment target used by `npx convex dev`
CONVEX_DEPLOYMENT=your_convex_deployment_selector_here # e.g., dev:joyous-egret-150

# Public URL of the Convex database instance (consumed by Client & Webhooks)
NEXT_PUBLIC_CONVEX_URL=your_convex_deployment_url_here

# Public site URL of Convex HTTP endpoints
NEXT_PUBLIC_CONVEX_SITE_URL=your_convex_site_url_here

# -------------------------------------------------------------------------
# Upstash Redis (Distributed caching & Rate Limiting - Optional in dev)
# -------------------------------------------------------------------------
# Server-side connection URL
UPSTASH_REDIS_REST_URL=your_upstash_redis_rest_url_here

# Server-side access token (Keep secret!)
UPSTASH_REDIS_REST_TOKEN=your_upstash_redis_rest_token_here

# -------------------------------------------------------------------------
# Clerk Authentication
# -------------------------------------------------------------------------
# Publicly accessible publishable key for Clerk client
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=your_clerk_publishable_key_here

# Server-side API key (Keep secret!)
CLERK_SECRET_KEY=your_clerk_secret_key_here

# Optional: Clerk webhook secret for user sync webhook (/api/webhooks/clerk)
CLERK_WEBHOOK_SECRET=your_clerk_webhook_secret_here

# Optional: Clerk JWT issuer domain for Convex authentication
CLERK_JWT_ISSUER_DOMAIN=your_clerk_jwt_issuer_domain_here

# Sign-in / Sign-up routes configuration
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/dashboard
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/dashboard

# -------------------------------------------------------------------------
# Razorpay Payment Integration (Test Mode for development)
# -------------------------------------------------------------------------
# Public API key ID (e.g., rzp_test_...)
NEXT_PUBLIC_RAZORPAY_KEY_ID=your_razorpay_key_id_here

# Server-side API key secret (Keep secret!)
RAZORPAY_KEY_SECRET=your_razorpay_key_secret_here

# Secret configured in Razorpay Dashboard for webhook signature verification
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret_here

# -------------------------------------------------------------------------
# Resend Transactional Email & Notifications
# -------------------------------------------------------------------------
# Server-side Resend API Key (e.g. re_...)
RESEND_API_KEY=your_resend_api_key_here

# Verified sending address / domain (e.g. "VibeLogic Studio <access@vibelogic.studio>")
RESEND_FROM_EMAIL=your_verified_from_email_here

# -------------------------------------------------------------------------
# Scheduled Tasks & Worker Security
# -------------------------------------------------------------------------
# Shared bearer token for scheduled jobs and email dispatch workers (/api/checkout/email-dispatch)
CRON_SECRET=your_strong_random_cron_secret_here

# -------------------------------------------------------------------------
# UploadThing (Media storage and uploads)
# -------------------------------------------------------------------------
# Server-side secret key (Keep secret!)
UPLOADTHING_SECRET=your_uploadthing_secret_here

# Project app ID
UPLOADTHING_APP_ID=your_uploadthing_app_id_here

# -------------------------------------------------------------------------
# PostHog Analytics (Optional)
# -------------------------------------------------------------------------
# Public key for tracking initialization
NEXT_PUBLIC_POSTHOG_KEY=your_posthog_key_here

# Analytics ingestion host endpoint
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# -------------------------------------------------------------------------
# Sentry (Error monitoring and tracing)
# -------------------------------------------------------------------------
# Auth token used by the Sentry build plugin to upload source maps
SENTRY_AUTH_TOKEN=your_sentry_auth_token_here
